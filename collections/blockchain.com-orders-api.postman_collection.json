      "item": [
        {
          "id": "36e31cbc-6b76-44d6-970c-cb726833a0da",
          "name": "Get orders",
          "request": {
            "name": "Get orders",
            "description": {
              "content": "Returns either:\n- A list of recent orders, limited to a maximum of 50 orders, sorted by descending creation date.\n- If `externalReference` is provided, returns all orders matching that reference.\n- If `walletAddress` is provided, returns all orders for that wallet address.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "The number of orders to return. Default and maximum is 50. Ignored when `externalReference` is provided."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The number of orders to skip. Use together with `limit` for pagination."
                },
                {
                  "disabled": false,
                  "key": "externalReference",
                  "value": "<string>",
                  "description": "External reference of the order(s) set by the partner."
                },
                {
                  "disabled": false,
                  "key": "walletAddress",
                  "value": "<string>",
                  "description": "User wallet address."
                },
                {
                  "disabled": false,
                  "key": "outputCurrency",
                  "value": "<string>",
                  "description": "Filter by output (crypto) currency code."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start of the date range, inclusive. Format: `YYYY-MM-DD`."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End of the date range, exclusive. Format: `YYYY-MM-DD`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Private-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
