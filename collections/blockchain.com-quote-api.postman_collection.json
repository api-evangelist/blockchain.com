      "id": "dcae75ab-1b6c-4fb5-badd-213ef4cedfeb",
      "name": "Quote",
      "description": {
        "content": "Real-time buy quotes.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0b966bbe-c355-4c88-932b-18dc5282f161",
          "name": "Get buy quote",
          "request": {
            "name": "Get buy quote",
            "description": {
              "content": "Returns a real-time buy quote for a currency pair.\nSupply `quoteCurrencyCode`, `baseCurrencyCode`, and `quoteCurrencyAmount` (fiat amount) to get a\ndetailed buy quote including fees and the amount of crypto the user will receive.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "quote",
                "buy"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "quoteCurrencyCode",
                  "value": "<string>",
                  "description": "(Required) The fiat currency to buy with."
                },
                {
                  "disabled": false,
                  "key": "baseCurrencyCode",
                  "value": "<string>",
                  "description": "(Required) The crypto currency to buy."
                },
                {
                  "disabled": false,
                  "key": "quoteCurrencyAmount",
                  "value": "<number>",
                  "description": "(Required) The fiat amount the customer wants to spend. Must be a positive decimal with precision no higher than the currency precision."
                },
                {
                  "disabled": false,
                  "key": "paymentMethod",
                  "value": "<string>",
                  "description": "Payment method to be used for the order. If omitted, the quote will not factor in payment method fees."
                },
                {
                  "disabled": false,
                  "key": "countryCode",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code, e.g. `US`."
                },
                {
                  "disabled": false,
                  "key": "usStateCode",
                  "value": "<string>",
                  "description": "US state code, e.g. `AL`. Ignored if `countryCode` is not `US`."
                },
                {
                  "disabled": false,
                  "key": "walletAddress",
                  "value": "<string>",
                  "description": "The wallet address where the user wants to receive the crypto."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Public-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
