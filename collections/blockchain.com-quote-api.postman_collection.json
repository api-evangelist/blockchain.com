  "info": {
    "_postman_id": "06798645-8125-48fd-b057-8304cfa62149",
    "name": "Blockchain.com Pay Partner Quote API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Partner API enables Blockchain.com Pay partners to integrate crypto purchase flows\ninto their backends. It provides eligibility data (currencies, regions, payment methods),\nreal-time buy quotes, and order management.\n\nAll endpoints require the `X-Public-API-Key` header to identify the partner.\nOrder endpoints additionally require the `X-Private-API-Key` header.\n",
      "type": "text/plain"
    }
  }
