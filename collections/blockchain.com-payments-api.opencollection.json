{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blockchain.com Exchange REST Payments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Token",
      "value": "{{X-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Receive current account balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/accounts"
          },
          "docs": "Receive current account balances"
        },
        {
          "info": {
            "name": "Receive current account balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/accounts/:account/:currency",
            "params": [
              {
                "name": "account",
                "value": "primary",
                "type": "path",
                "description": "Account"
              },
              {
                "name": "currency",
                "value": "",
                "type": "path",
                "description": "Currency"
              }
            ]
          },
          "docs": "Receive current account balances"
        },
        {
          "info": {
            "name": "Get a deposit address. Currently only crypto currencies are supported",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blockchain.com/v3/exchange/deposits/:currency",
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "path",
                "description": "Currency"
              }
            ]
          },
          "docs": "Get a deposit address. Currently only crypto currencies are supported"
        },
        {
          "info": {
            "name": "Get a list of deposits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/deposits",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Epoch timestamp in ms"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Epoch timestamp in ms"
              }
            ]
          },
          "docs": "Get a list of deposits"
        },
        {
          "info": {
            "name": "Get status about a deposit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/deposits/:depositId",
            "params": [
              {
                "name": "depositId",
                "value": "",
                "type": "path",
                "description": "Deposit ID"
              }
            ]
          },
          "docs": "Get status about a deposit"
        },
        {
          "info": {
            "name": "Get a list of all whitelisted withdrawal accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/whitelist"
          },
          "docs": "Get a list of all whitelisted withdrawal accounts"
        },
        {
          "info": {
            "name": "Get a list of all whitelisted withdrawal accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/whitelist/:currency",
            "params": [
              {
                "name": "currency",
                "value": "",
                "type": "path",
                "description": "Currency"
              }
            ]
          },
          "docs": "Get a list of all whitelisted withdrawal accounts"
        },
        {
          "info": {
            "name": "Get a list of withdrawals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/withdrawals",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Epoch timestamp in ms"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Epoch timestamp in ms"
              }
            ]
          },
          "docs": "Get a list of withdrawals"
        },
        {
          "info": {
            "name": "Request a withdrawal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blockchain.com/v3/exchange/withdrawals",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Call `GET /whitelist` first to retrieve the ID of the beneficiary. To add a beneficiary to the whitelist, please visit the profile page in the Exchange. This call only works if 2FA is enabled on the account."
        },
        {
          "info": {
            "name": "Get status about a withdrawal",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.blockchain.com/v3/exchange/withdrawals/:withdrawalId",
            "params": [
              {
                "name": "withdrawalId",
                "value": "",
                "type": "path",
                "description": "Withdrawal ID"
              }
            ]
          },
          "docs": "Get status about a withdrawal"
        }
      ]
    }
  ],
  "bundled": true
}